<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Compilazione desktop del motore. Lo STESSO sorgente viene incluso nel progetto
    dell'app WP8.1 (Tailscale\Tailscale.csproj) via <Compile Include="..\src\...">:
    LangVersion 5 è imposto qui e sul telefono, così una sintassi non compilabile
    dal compilatore WP8.1 non passa inosservata.
  -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{2F1A4C10-6B3E-4C8A-9E11-5C0A7D1B2A01}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Tailscale.Core</RootNamespace>
    <AssemblyName>Tailscale.Core</AssemblyName>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <LangVersion>5</LangVersion>
    <FileAlignment>512</FileAlignment>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
